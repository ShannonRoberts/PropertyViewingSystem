# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Rails specific
backend/log/*.log
backend/tmp/
backend/db/*.sqlite3
backend/db/*.sqlite3-*
backend/config/master.key
backend/config/credentials.yml.enc
backend/storage/
backend/public/uploads/

# Node.js / React specific
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Frontend build artifacts
frontend/build/
frontend/dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
*.swp
*.swo
*~

# Dependency directories
vendor/bundle/

# Ruby version managers
.rvmrc
.ruby-version
.ruby-gemset

# Coverage reports
coverage/
.nyc_output/

# OS generated files
.DS_Store?
ehthumbs.db
Thumbs.db

# Rails cache and temp files
.sass-cache/
.byebug_history
.pry_history

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Webpack build artifacts
public/packs/
public/packs-test/
node_modules.yarn-integrity
